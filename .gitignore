*.pyc
.venv/
.DS_Store

# Raw and derived market data. Everything here is rebuildable from the public
# archive by `make download parse` or `make intraday-cache`, and is far too
# large to version.
data/raw/
data/parquet/
data/*.parquet
data/download_failures.tsv
data/parquet/parse_failures.tsv

# Written by the live-plan tool against current market state, so it is a
# snapshot of one moment rather than a research output.
results/live_plan.json
results_futures_1h/live_plan.json

# Regenerated by `make discover`; the coverage summary in manifest.json is
# what the report actually reads.
data/manifest.txt
